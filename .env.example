APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_DEMO_DIR=frontend/demo

# LLM (OpenAI-compatible) — 真实密钥写在 .env，不要提交
DEEPSEEK_KEY=
DEEPSEEK_BASE=https://api.deepseek.com
# `deepseek-flash`, not `deepseek-v4-pro`. Both are served by the same endpoint,
# and v4-pro is a *reasoning* model: on the storyboard prompt it spent ~26k
# tokens thinking before writing a word, which measured 461s per call and sat
# close enough to the 32768 output ceiling that it regularly came back
# truncated. flash answered the same prompt in 48s with a longer body.
DEEPSEEK_MODEL=deepseek-flash
KIMI_KEY=

